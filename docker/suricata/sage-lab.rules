# Laboratory Suricata rules (reviewed; local SIDs 9000001-9000099). Passive alerting only.
alert tcp any any -> 172.30.0.10 18100:18115 (msg:"SAGE LAB possible TCP port sweep"; flags:S; threshold: type both, track by_src, count 5, seconds 5; classtype:attempted-recon; sid:9000001; rev:1;)
alert http any any -> 172.30.0.10 18081 (msg:"SAGE LAB repeated failed logins"; flow:to_client,established; http.stat_code; content:"401"; threshold: type both, track by_dst, count 5, seconds 10; classtype:attempted-user; sid:9000002; rev:1;)
alert http any any -> 172.30.0.10 18082 (msg:"SAGE LAB high request rate"; flow:to_server,established; threshold: type both, track by_src, count 100, seconds 2; classtype:attempted-dos; sid:9000003; rev:1;)
