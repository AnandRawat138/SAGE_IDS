# Copy to .env and fill in. Never commit .env. No secrets are required for the offline demo.

# Privileged API actions are DISABLED unless an operator key is set (use a long random value).
SAGE_OPERATOR_KEY=
# Optional read-only key; if unset, read endpoints are open on the loopback interface.
SAGE_VIEWER_KEY=
# Operator name the dashboard sends in X-Operator for privileged actions.
SAGE_OPERATOR_NAME=

# Active laboratory scenarios are opt-in (1 to enable). They only ever target allowlisted lab hosts.
SAGE_ENABLE_ACTIVE_LAB=0

# Optional overrides
# SAGE_CONFIG=configs/sage.yaml
# SAGE_DATABASE_URL=sqlite:///data/sage_ids.db
# SAGE_API_URL=http://127.0.0.1:8000

# Optional LLM provider (default: none = deterministic). Output is never executed.
# SAGE_LLM_PROVIDER=none        # none | ollama | anthropic
# SAGE_LLM_MODEL=
# SAGE_OLLAMA_URL=http://127.0.0.1:11434
# ANTHROPIC_API_KEY=            # only if SAGE_LLM_PROVIDER=anthropic (pip install anthropic)
